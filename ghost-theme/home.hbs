{{!< default}}

{{!-- Header --}}
<div class="site-header">
  <div class="site-header-left">
    <h1 class="site-title">{{@site.title}}</h1>
    <a class="subscribe-btn" href="#/portal/signup" data-portal="signup">Subscribe</a>
  </div>
  {{> social-links}}
</div>

{{!-- Bio --}}
<p class="bio">{{@site.description}}</p>

{{!-- Blog --}}
<section class="section">
  <h2 class="section-title">Blog</h2>
  <ul class="post-list">
    {{#get "posts" limit="4" order="published_at desc"}}
      {{#foreach posts}}
        {{> post-card}}
      {{/foreach}}
    {{/get}}
  </ul>
  <div class="view-all">
    <a href="/blog/" class="btn-outline">All Blog Posts</a>
  </div>
</section>

{{!-- Open Source Projects --}}
<section class="section-spacing">
  <h2 class="section-title">Open Source Projects</h2>
  <ul class="post-list">
    <li class="oss-card">
      <a href="https://github.com/zeekrey/ninstagram">
        <div>
          <h2>
            <span class="oss-prefix">zeekrey/</span><strong>ninstagram</strong>
            <span class="badge">TypeScript</span>
          </h2>
          <p class="summary">A headless Instagram feed for your website.</p>
        </div>
        <div class="oss-stars">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <small>11</small>
        </div>
      </a>
    </li>
    <li class="oss-card">
      <a href="https://github.com/zeekrey/just-flip-it">
        <div>
          <h2>
            <span class="oss-prefix">zeekrey/</span><strong>just-flip-it</strong>
            <span class="badge">TypeScript</span>
          </h2>
          <p class="summary">Feature flagging made easy.</p>
        </div>
        <div class="oss-stars">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <small>4</small>
        </div>
      </a>
    </li>
    <li class="oss-card">
      <a href="https://github.com/zeekrey/kreyio">
        <div>
          <h2>
            <span class="oss-prefix">zeekrey/</span><strong>kreyio</strong>
            <span class="badge">TypeScript</span>
          </h2>
          <p class="summary">My personal website and blog.</p>
        </div>
        <div class="oss-stars">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <small>2</small>
        </div>
      </a>
    </li>
  </ul>
</section>

{{!-- Commercial Projects --}}
<section class="section-spacing">
  <h2 class="section-title">Commercial Projects (Freelance)</h2>
  <ul class="post-list">
    {{#get "pages" filter="tag:hash-commercial-project" order="published_at desc"}}
      {{#foreach pages}}
        <li class="post-card">
          <a href="{{url}}">
            <div>
              <time class="post-card-date" datetime="{{date format="YYYY-MM-DD"}}">
                {{date published_at format="MM.YYYY"}}
              </time>
              <h2>{{title}}</h2>
            </div>
            <div class="arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 16 16 12 12 8"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </div>
          </a>
        </li>
      {{/foreach}}
    {{/get}}
  </ul>
</section>
